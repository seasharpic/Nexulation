<UserControl x:Class="NexulationTool.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="TxtHeadingDashboard" Text="System Dashboard" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,14"/>

            <!-- System Specs Grid -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" x:Name="CardOS" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,6">
                    <StackPanel>
                        <TextBlock Text="SYSTEM OS" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtOS" Text="Windows 11" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" x:Name="CardCPU" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,6">
                    <StackPanel>
                        <TextBlock Text="PROCESSOR (CPU)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtCPU" Text="Loading..." FontSize="14" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" x:Name="CardGPU" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,6,0">
                    <StackPanel>
                        <TextBlock Text="GRAPHICS (GPU)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtGPU" Text="Loading..." FontSize="14" Foreground="#818CF8" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" x:Name="CardRAM" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,6,0,0">
                    <StackPanel>
                        <TextBlock Text="MEMORY (RAM)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtRAM" Text="Loading..." FontSize="14" Foreground="#34D399" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Power Plan Control Card -->
            <Border x:Name="CardPowerPlan" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="POWER PLAN CONTROL" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Active Power Scheme:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="TxtActivePlan" Text="Detecting..." FontSize="13" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnRyzen" Grid.Column="0" Margin="0,0,5,0" Height="36" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                            <TextBlock Text="Set Power-Plan (Ryzen)"/>
                        </Button>

                        <Button x:Name="BtnIntel" Grid.Column="1" Margin="5,0,5,0" Height="36" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                            <TextBlock Text="Set Power-Plan (Intel)"/>
                        </Button>

                        <Button x:Name="BtnUltimate" Grid.Column="2" Margin="5,0,0,0" Height="36" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                            <TextBlock Text="Set Ultimate Plan"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Driver DPC/ISR & MSI Status Scanner Card -->
            <Border x:Name="CardDriverStatus" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="DRIVER DPC/ISR &amp; MSI STATUS" FontWeight="Bold" FontSize="12" Foreground="#34D399" VerticalAlignment="Center"/>
                        <Button x:Name="BtnRefreshDrivers" HorizontalAlignment="Right" Width="130" Height="26" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource SecondaryTextBrush}" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                            <TextBlock Text="Re-Scan DPC Drivers"/>
                        </Button>
                    </Grid>

                    <Grid Margin="0,4">
                        <TextBlock Text="GPU Driver (nvlddmkm):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="TxtStatusGPU" Text="Checking..." FontSize="11" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <TextBlock Text="Net Driver (ndis.sys):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="TxtStatusNet" Text="Checking..." FontSize="11" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <TextBlock Text="NVMe Driver (stornvme):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="TxtStatusNVMe" Text="Checking..." FontSize="11" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <TextBlock Text="USB Host (USBPORT):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="TxtStatusUSB" Text="Checking..." FontSize="11" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
