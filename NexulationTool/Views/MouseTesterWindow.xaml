<Window x:Class="NexulationTool.Views.MouseTesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseTester - Polling Rate &amp; Latency Analyzer" Height="500" Width="700"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="#0C101C" Foreground="#F3F4F6" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#2D3A54" BorderThickness="1" CornerRadius="8" Background="#0C101C">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- TitleBar -->
            <Border Grid.Row="0" Background="#111827" CornerRadius="8,8,0,0" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" Margin="0,0,10,0"/>
                        <TextBlock Text="MOUSETESTER" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                        <TextBlock Text=" | Polling Rate &amp; Latency Analyzer" FontSize="12" Foreground="#64748B" Margin="8,1,0,0"/>
                    </StackPanel>

                    <Button Click="BtnClose_Click" HorizontalAlignment="Right" Width="35" Height="30" Content="✕" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="12" Cursor="Hand" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status Header -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="POLLING RATE (HZ)" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtHz" Text="0 Hz" FontSize="26" Foreground="#10B981" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="AVG INTERVAL (MS)" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtAvgInterval" Text="0.00 ms" FontSize="22" Foreground="#38BDF8" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MIN / MAX INTERVAL" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtMinMaxInterval" Text="0.0 / 0.0 ms" FontSize="18" Foreground="#F59E0B" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="TOTAL PACKETS" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtPackets" Text="0" FontSize="22" Foreground="#F1F5F9" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Interactive Capture Zone -->
                <Border Grid.Row="1" x:Name="TestArea" Background="#111827" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="6" MouseMove="TestArea_MouseMove" Cursor="Cross">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="MOVE MOUSE FAST INSIDE THIS BOX" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Move continuously to measure Real-Time Polling Rate (1000Hz / 4000Hz / 8000Hz) &amp; Interval Jitter" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Controls Footer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Click="BtnReset_Click" Width="120" Height="36" Content="Reset Data" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <Button Click="BtnClose_Click" Width="100" Height="36" Content="Close" Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <!-- Footer Status -->
            <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                <TextBlock x:Name="TxtMouseStatus" Text="Move cursor inside test box to analyze high-precision polling interval..." VerticalAlignment="Center" Margin="15,0,0,0" FontSize="11" Foreground="#64748B"/>
            </Border>
        </Grid>
    </Border>
</Window>
