<Window x:Class="NexulationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexulation Tool v2.0" Height="730" Width="1060"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar Button Style with Segoe MDL2 Icons & Center-Origin Scaling -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" RenderTransformOrigin="0.5,0.5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Action Button Style -->
        <Style TargetType="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" RenderTransformOrigin="0.5,0.5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Animated Toggle Switch Style for CheckBox -->
        <Style x:Key="Win11ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="SwitchTrack" Width="44" Height="22" CornerRadius="11" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <Ellipse x:Name="SwitchThumb" Width="14" Height="14" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#10B981"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainFrameBorder" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1.5" CornerRadius="12" Background="{DynamicResource WindowBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <!-- Header TitleBar -->
                <RowDefinition Height="*"/>
                <!-- Main Layout -->
                <RowDefinition Height="34"/>
                <!-- Footer Bar -->
            </Grid.RowDefinitions>

            <!-- Header TitleBar -->
            <Border Grid.Row="0" x:Name="TitleBarBorder" Background="{DynamicResource HeaderBgBrush}" CornerRadius="12,12,0,0" MouseDown="TitleBar_MouseDown" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <!-- App Logo Icon -->
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtTitleMain" Text="NEXULATION" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="TxtTitleSub" Text="TOOL v2.0" FontWeight="Light" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="38" Height="30" Content="—" Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" BorderThickness="0" FontSize="13" Cursor="Hand"/>
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Width="38" Height="30" Content="✕" Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" BorderThickness="0" FontSize="13" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Layout: Left Sidebar + Right Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <!-- Sidebar Navigation -->
                    <ColumnDefinition Width="*"/>
                    <!-- Active View Host -->
                </Grid.ColumnDefinitions>

                <!-- Navigation Sidebar -->
                <Border Grid.Column="0" x:Name="SidebarBorder" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="12,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!-- Primary Items -->
                            <RowDefinition Height="Auto"/>
                            <!-- Anchored Bottom Settings -->
                        </Grid.RowDefinitions>

                        <!-- Primary Items -->
                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="TxtNavHeader" Text="SYSTEM ENGINE" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold" Margin="10,0,0,12"/>

                            <!-- Nav Item 1: Overview -->
                            <Button x:Name="BtnNavDashboard" Style="{StaticResource SidebarButtonStyle}" Click="BtnNav_Click" Tag="Dashboard" Height="42" Margin="0,0,0,6" Background="{DynamicResource NavHoverBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Overview" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Nav Item 2: Performance -->
                            <Button x:Name="BtnNavLatency" Style="{StaticResource SidebarButtonStyle}" Click="BtnNav_Click" Tag="Latency" Height="42" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA80;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Performance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Nav Item 3: Diagnostics & Tools -->
                            <Button x:Name="BtnNavDiagnostics" Style="{StaticResource SidebarButtonStyle}" Click="BtnNav_Click" Tag="Diagnostics" Height="42" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Nav Item 4: Customization -->
                            <Button x:Name="BtnNavCustomization" Style="{StaticResource SidebarButtonStyle}" Click="BtnNav_Click" Tag="Customization" Height="42" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Customization" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Anchored Bottom Settings -->
                        <StackPanel Grid.Row="1">
                            <Button x:Name="BtnNavSettings" Style="{StaticResource SidebarButtonStyle}" Click="BtnNav_Click" Tag="Settings" Height="42" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Preferences" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right View Content Host Area -->
                <Grid Grid.Column="1" Margin="22,18,22,18">

                    <!-- TAB 1: OVERVIEW (DASHBOARD) -->
                    <Grid x:Name="TabDashboard" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Hero Latency Health Overview Banner -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="LATENCY HEALTH SCORE:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                    <TextBlock Text="OPTIMIZED" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                                <TextBlock Text="98" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="/100" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                                            </StackPanel>

                                            <!-- Live System Status Badges -->
                                            <WrapPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                                                        <TextBlock Text="0.5ms Timer Locked" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                                                        <TextBlock Text="MSI Mode Active" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#57A2AF" Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="TxtHeroPowerPlan" Text="Ryzen Power Plan" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Quick System Boost Button -->
                                        <Button Click="BtnQuickBoost_Click" Grid.Column="1" Width="170" Height="44" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7E6;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Quick System Boost" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Hardware Specs Grid -->
                                <TextBlock Text="HARDWARE SPECIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,10"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- OS Card -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,6">
                                        <StackPanel>
                                            <TextBlock Text="SYSTEM OS" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtOS" Text="Windows 11" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CPU Card -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="PROCESSOR (CPU)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtCPU" Text="Loading..." FontSize="14" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU Card -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,6,0">
                                        <StackPanel>
                                            <TextBlock Text="GRAPHICS (GPU)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtGPU" Text="Loading..." FontSize="14" Foreground="#818CF8" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- RAM Card -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="MEMORY (RAM)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtRAM" Text="Loading..." FontSize="14" Foreground="#34D399" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Power Plan Control Center -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="POWER PLAN CONTROL" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Active Power Scheme:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="TxtActivePlan" Text="Detecting..." FontSize="13" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,12"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Click="BtnApplyRyzenPlan_Click" Grid.Column="0" Margin="0,0,5,0" Height="36" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                                                <TextBlock Text="Set Ryzen Plan"/>
                                            </Button>

                                            <Button Click="BtnApplyIntelPlan_Click" Grid.Column="1" Margin="5,0,5,0" Height="36" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                                                <TextBlock Text="Set Intel Plan"/>
                                            </Button>

                                            <Button Click="BtnApplyUltimatePlan_Click" Grid.Column="2" Margin="5,0,0,0" Height="36" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                                                <TextBlock Text="Set Ultimate Plan"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Driver Status Scanner -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="DRIVER DPC/ISR &amp; MSI STATUS" FontWeight="Bold" FontSize="12" Foreground="#34D399" VerticalAlignment="Center"/>
                                            <Button Click="BtnRefreshDriverStatus_Click" HorizontalAlignment="Right" Width="130" Height="26" Background="{DynamicResource HeaderBgBrush}" Foreground="{DynamicResource SecondaryTextBrush}" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock Text="Re-Scan Drivers"/>
                                            </Button>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <TextBlock Text="GPU Driver (nvlddmkm):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock x:Name="TxtStatusGPU" Text="Checking..." FontSize="11" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <TextBlock Text="Net Driver (ndis.sys):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock x:Name="TxtStatusNet" Text="Checking..." FontSize="11" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <TextBlock Text="NVMe Driver (stornvme):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock x:Name="TxtStatusNVMe" Text="Checking..." FontSize="11" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <TextBlock Text="USB Host (USBPORT):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock x:Name="TxtStatusUSB" Text="Checking..." FontSize="11" Foreground="#34D399" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 2: PERFORMANCE & LATENCY -->
                    <Grid x:Name="TabLatency" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Performance &amp; Latency Tweaks" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,14"/>

                                <!-- Toggle 1: MSI Mode -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PCIe MSI Mode (GPU, USB &amp; Net)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Eliminates IRQ conflicts and lowers DPC/ISR interrupt latency." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkToggleMSI" Click="ChkToggleMSI_Click" Grid.Column="1" Style="{StaticResource Win11ToggleSwitch}" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <!-- Toggle 2: Low-Ping TCP -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Low-Ping TCP (No Nagle Algorithm)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Instant TCP ACK packets without network buffering delay." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkTogglePing" Click="ChkTogglePing_Click" Grid.Column="1" Style="{StaticResource Win11ToggleSwitch}" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <!-- Toggle 3: Memory Compression -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Disable Memory Compression (MMAgent)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Disables CPU-overhead RAM page compression for 16GB+ RAM." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkToggleMemComp" Click="ChkToggleMemComp_Click" Grid.Column="1" Style="{StaticResource Win11ToggleSwitch}"/>
                                    </Grid>
                                </Border>

                                <!-- Toggle 4: Hypervisor BCD -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Bare-Metal CPU Access (Disable Hypervisor)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Disables virtualization layer for +5-10% FPS gain in games." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkToggleHypervisor" Click="ChkToggleHypervisor_Click" Grid.Column="1" Style="{StaticResource Win11ToggleSwitch}" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <!-- Toggle 5: Keyboard Repeat Rate -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Keyboard Max Repeat Rate (Delay=0, Speed=31)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Instant key repeat responsiveness without OS delays." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkToggleKeyboard" Click="ChkToggleKeyboard_Click" Grid.Column="1" Style="{StaticResource Win11ToggleSwitch}" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <!-- Toggle 6: System Timer Resolution (0.5ms) -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="0.5ms Global System Timer Resolution" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock x:Name="TxtTimerResInfo" Text="Current Resolution: 0.500 ms (Locked)" FontSize="11" Foreground="#34D399" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Click="BtnToggleTimerRes_Click" Grid.Column="1" Width="100" Height="36" Content="0.5 ms" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 3: DIAGNOSTICS & TOOLS -->
                    <Grid x:Name="TabDiagnostics" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Diagnostics &amp; System Maintenance" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,14"/>

                                <!-- xperf ETW Tracer -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="DPC/ISR LATENCY TRACER (xperf / WPA)" FontWeight="Bold" FontSize="13" Foreground="#F59E0B" Margin="0,0,0,6"/>
                                        <TextBlock Text="Runs a 10-second ETW kernel trace to detect driver DPC/ISR latency spikes. Saves .etl log to Desktop and opens WPA." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <Button Click="BtnRunXperfTrace_Click" Height="40" Background="#D97706" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                                            <TextBlock Text="Run DPC/ISR Latency Trace (xperf / WPA)"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- MouseTester Window Launcher -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="MOUSETESTER (POLLING RATE &amp; LATENCY)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Interactive real-time mouse polling rate (1000Hz - 8000Hz+) and packet delivery interval analyzer with microsecond precision." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <Button Click="BtnLaunchMouseTester_Click" Height="40" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                                            <TextBlock Text="Launch MouseTester Window"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 1-Click Temp Cleaner -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="1-CLICK TEMP &amp; CACHE CLEANER" FontWeight="Bold" FontSize="13" Foreground="#34D399" Margin="0,0,0,6"/>
                                        <TextBlock Text="Safely purges temporary files, shader caches, and Windows update temp files." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <Button Click="BtnCleanTemp_Click" Height="40" Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                                            <TextBlock Text="Clean Temp &amp; Shader Caches"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- RAM Trimmer -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="RAM WORKING SET TRIMMER" FontWeight="Bold" FontSize="13" Foreground="#34D399" Margin="0,0,0,6"/>
                                        <TextBlock Text="Flushes process working sets to free up standby memory immediately." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <Button Click="BtnTrimRAM_Click" Height="40" Background="#047857" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                                            <TextBlock Text="Trim System RAM Working Set"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 4: CUSTOMIZATION -->
                    <Grid x:Name="TabCustomization" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="System Customization &amp; Wallpaper" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,14"/>

                                <!-- Official Wallpaper Card -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="OFFICIAL NEXULATION WALLPAPER" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Applies the official Nexulation Dark/Light wallpaper to your Windows desktop." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <Button Click="BtnApplyWallpaper_Click" Height="38" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                                            <TextBlock Text="Apply Official Nexulation Wallpaper"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 5: PREFERENCES & SETTINGS -->
                    <Grid x:Name="TabSettings" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Grid.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Preferences &amp; UI Customization" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,14"/>

                                <!-- UI Theme Customization Card -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="UI Theme Customization" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Select UI Theme mode: System Auto, Fluent Dark, or Clean Light." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="BtnThemeAuto" Click="BtnThemeAuto_Click" Width="70" Height="34" Content="Auto" Cursor="Hand" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <Button x:Name="BtnThemeDark" Click="BtnThemeDark_Click" Width="70" Height="34" Content="Dark" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                            <Button x:Name="BtnThemeLight" Click="BtnThemeLight_Click" Width="70" Height="34" Content="Light" Cursor="Hand" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Auto-Run with Windows -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Run with Windows Startup" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Launches Nexulation Tool automatically when Windows boots up." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkToggleAutoRun" Click="ChkToggleAutoRun_Click" Grid.Column="1" Style="{StaticResource Win11ToggleSwitch}"/>
                                    </Grid>
                                </Border>

                                <!-- Auto Lock 0.5ms Timer on Startup -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Lock 0.5ms System Timer on Startup" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Locks timer resolution to 0.500 ms immediately upon launch." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkToggleAutoTimer" Click="ChkToggleAutoTimer_Click" Grid.Column="1" Style="{StaticResource Win11ToggleSwitch}" IsChecked="True"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- Footer Glass Bar -->
            <Border Grid.Row="2" x:Name="FooterBorder" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <Grid Margin="20,0">
                    <TextBlock x:Name="TxtStatus" Text="Ready | Nexulation Engine Status: Active" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
